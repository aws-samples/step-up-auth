{
  "name": "sample-web-app",
  "version": "1.0.0",
  "description": "Sample web client that demonstrates how to handle step-up authentication",
  "main": "index.js",
  "directories": {
    "test": "test",
    "src": "src"
  },
  "author": "AWS Professional Services",
  "repository": {
    "type": "git",
    "url": "https://code.amazon.com/packages/StepUpAuth/trees/mainline"
  },
  "bugs": {
    "url": "https://code.amazon.com/packages/StepUpAuth/trees/mainline"
  },
  "homepage": "https://code.amazon.com/packages/StepUpAuth/trees/mainline",
  "keywords": [
    "react",
    "amplify",
    "step-up auth client"
  ],
  "private": "true",
  "scripts": {
    "start": "webpack serve --config webpack.config.js --progress --stats-children --env NODE_ENV=development",
    "build": "webpack --env NODE_ENV=production --progress",
    "build-dev": "webpack --env NODE_ENV=development --progress",
    "lint": "eslint .",
    "test-unit": "jest --coverage=true --testRegex='(/tests/unit/.*\\.(test|spec))\\.js?$'",
    "test-unit-updatesnapshot": "jest --testRegex='(/tests/unit/.*\\.(test|spec))\\.js?$' -u",
    "test-int": "jest --coverage=true --testRegex='(/tests/integration/.*\\.(test|spec))\\.js?$'"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^9.39.5",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "identity-obj-proxy": "3.0.0",
    "jest": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.32",
    "postcss-loader": "^8.2.1",
    "raw-loader": "4.0.2",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-manifest-plugin": "^6.0.1"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.10",
    "aws-amplify": "^6.22.2",
    "prop-types": "^15.8.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^8.1.3",
    "react-router": "^7.18.5",
    "react-router-dom": "^7.18.5",
    "redux": "^4.2.1",
    "redux-form": "^8.3.10",
    "redux-thunk": "^2.4.2",
    "semantic-ui-css": "^2.5.0",
    "semantic-ui-react": "^2.1.5"
  },
  "jest": {
    "moduleNameMapper": {
      "^.+\\.css$": "identity-obj-proxy",
      "^.+\\.(ico|jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/test/__mocks__/fileMock.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.jsx",
      "!src/config.js",
      "!src/components/common/CustomSemanticUIControls.jsx"
    ]
  }
}
